        207.75344848632812
      ],
      "text": "MAN:\n"
    },
    {
      "box": [
        72.0,
        208.2346954345703,
        491.0124816894531,
        246.95361328125
      ],
      "text": "Sorry to interrupt. I just thought of another furniture rental company. It's\ncalled Space Rentals, and it's located very near to the house.\n"
    },
    {
      "box": [
        72.0,
        259.89202880859375,
