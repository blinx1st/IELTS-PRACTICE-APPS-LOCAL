    {
      "box": [
        69.8243408203125,
        365.3177795410156,
        391.40472412109375,
        403.47998046875
      ],
      "text": "B _\nthis book was not seriously intending to predict the future.\nC\nartificial speech translation was not a surprising development.\nD_\nsome speech translation techniques are better than others.\n"
    },
