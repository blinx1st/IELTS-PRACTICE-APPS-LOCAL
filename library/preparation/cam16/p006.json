  "blocks": [
    {
      "box": [
        415.4254150390625,
        25.514345169067383,
        471.8514404296875,
        33.7001953125
      ],
      "text": "Introduction\n"
    },
    {
      "box": [
        40.561222076416016,
        59.206321716308594,
        287.8243713378906,
        69.35675811767578
      ],
      "text": "The test components are taken in the following order:\n"
    },
    {
      "box": [
        154.721435546875,
        90.93563079833984,
        357.9364013671875,
        113.84294128417969
      ],
      "text": "Listening\n4 parts, 40 items, approximately 30 minutes\n"
    },
    {
      "box": [
        87.0103530883789,
        125.60897064208984,
        441.79180908203125,
        159.63589477539062
      ],
      "text": "Academic Reading\nGeneral Training Reading\n3 sections, 40 items\nor\n3 sections, 40 items\n60 minutes\n60 minutes\n"
    },
    {
      "box": [
        90.28142547607422,
        173.36647033691406,
        439.140625,
        207.39346313476562
      ],
      "text": "Academic Writing\nGeneral Training Writing\n2 tasks\nor\n2 tasks\n60 minutes\n60 minutes\n"
    },
    {
      "box": [
        219.16143798828125,
        221.45118713378906,
        294.7886047363281,
        242.39385986328125
      ],
      "text": "Speaking\n11 to 14 minutes\n"
    },
    {
      "box": [
        212.2921905517578,
        256.12451171875,
        301.0950012207031,
        276.7397155761719
      ],
      "text": "Total Test Time\n2 hours 44 minutes\n"
    },
    {
      "box": [
        40.88832473754883,
        309.1157531738281,
        218.7034912109375,
        318.93878173828125
      ],
      "text": "ACADEMIC TEST FORMAT\n"
    },
    {
      "box": [
        41.86964797973633,
        335.61138916015625,
        93.38886260986328,
        347.0715637207031
      ],
      "text": "Listening\n"
    },
    {
      "box": [
        41.215431213378906,
        353.602294921875,
        471.58966064453125,
        376.83697509765625
      ],
      "text": "This test consists of four parts, each with ten questions. The first two parts are concerned\nwith social needs. The first part is\na conversation between two speakers and the second part\n"
    },
    {
      "box": [
        41.215431213378906,
        379.44366455078125,
        471.988525390625,
        455.01544189453125
      ],
      "text": "is a monologue. The final two parts are concerned with situations related to educational or\ntraining contexts. The third part is\na conversation between up to four people and the fourth\npart is\na monologue.\nA variety of question types is used, including: multiple choice, matching, plan/map/\ndiagram labelling, form completion, note completion, table completion, flow-chart completion,\nsummary completion, sentence completion and short-answer questions.\n"
    },
    {
      "box": [
        41.86960983276367,
        457.6221618652344,
        466.7811279296875,
        478.89227294921875
      ],
      "text": "Candidates hear the recording once only and answer the questions as they listen. Ten\nminutes are allowed at the end for candidates to transfer their answers to the answer sheet.\n"
    },
    {
      "box": [
        42.196712493896484,
        492.9496765136719,
        87.87715148925781,
        504.40985107421875
      ],
      "text": "Reading\n"
    },
    {
      "box": [
        41.54249954223633,
        510.9405212402344,
        463.1959228515625,
        534.175537109375
      ],
      "text": "This test consists of three sections with 40 questions. There are three texts, which are\ntaken from journals, books, magazines and newspapers. The texts are on topics of general\n"
    },
    {
      "box": [
        42.19668197631836,
        537.1090698242188,
        321.13677978515625,
        546.9320678710938
      ],
      "text": "interest. At least one text contains detailed logical argument.\n"
    },
    {
      "box": [
        41.86948776245117,
        549.8662109375,
        465.7079162597656,
        613.662841796875
      ],
      "text": "A variety of question types is used, including: multiple choice, identifying information\n(True/False/Not Given), identifying the writer’s views/claims (Yes/No/Not Given), matching\ninformation, matching headings, matching features, matching sentence endings, sentence\ncompletion, summary completion, note completion, table completion, flow-chart completion,\ndiagram-label completion and short-answer questions.\n"
    },
    {
      "box": [
        468.7436218261719,
        663.0451049804688,
        473.9642333984375,
        670.903564453125
      ],
      "text": "5\n"
    }
  ]
}